# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AI Fitness Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Comma-separated (no quotes, no brackets)
ALLOWED_ORIGINS_STR=http://localhost:3000,http://localhost:3100,http://localhost:8080

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fitness:fitness@postgres:5432/fitness_platform
REDIS_URL=redis://redis:6379/0

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=dev-token-change-in-production
INFLUX_ORG=fitness
INFLUX_BUCKET=metrics

# ── AI — Ollama (local LLM, no API key required!) ─────────────────────────────
OLLAMA_URL=http://ollama:11434
COACH_MODEL=llama3.1:8b
VECTOR_MEMORY_DIR=/app/coach_memory

# ── OAuth / Wearables (optional) ──────────────────────────────────────────────
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=

# ── Storage (RustFS local S3-compatible storage) ──────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fitness-platform

# ── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=

# ── AI API Keys & Providers (Gemini, Groq, Ollama) ───────────────────────────
# 1. Google Gemini API Key: Get free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq API Key: Get free at https://console.groq.com/keys (~800 tok/s speed)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Default AI Provider: auto | gemini | groq | ollama
AI_PROVIDER=auto

# ── Nutrition APIs ────────────────────────────────────────────────────────────
# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-guide
USDA_API_KEY=
OPENROUTER_API_KEY=
